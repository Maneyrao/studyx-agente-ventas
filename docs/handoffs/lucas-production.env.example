# Inventario de producción para studyx-agente-ventas-sigma.vercel.app.
# No pegar valores reales en Git. Conservar los valores ya cargados por Lucas.

# Núcleo obligatorio: /api/ready no acepta tráfico sin estos nombres.
DATABASE_URL=<secret>
BUSINESS_WORKSPACE_SLUG=studyx
ORCHESTRATOR_API_KEY=<secret; igual a Botpress STUDYX_ORCHESTRATOR_KEY>
ORCHESTRATOR_KEY_ID=botpress-dev
STUDYX_SIGNING_SECRET=<secret; igual en Botpress>
CRON_SECRET=<secret>
PAYMENT_LINK_12M=<secret-url>
PAYMENT_LINK_6M=<secret-url>
PAYMENT_LINK_CONTADO=<secret-url>

# Modelo, memoria y proyección. Mantener los valores actuales de producción.
DEEPSEEK_API_KEY=<secret>
GEMINI_API_KEY=<secret>
GEMINI_MODEL=<current-production-value>
GOOGLE_SHEETS_CLIENT_EMAIL=<secret>
GOOGLE_SHEETS_PRIVATE_KEY=<secret>
GOOGLE_SHEETS_SPREADSHEET_ID=<current-production-value>
GOOGLE_SHEETS_TAB_NAME=<current-production-value>

# Identidad y comportamiento ya aprobados. No copiar los defaults apagados de
# .env.example sobre los valores existentes de Lucas.
AGENT_A_ADVISOR_NAME=Emma
AGENT_A_BRAIN_V1_ENABLED=<keep-current-production-value>
AGENT_A_BRAIN_V1_SHADOW=<keep-current-production-value>
AGENT_A_CONTEXT_SCOPING=<keep-current-production-value>
AGENT_A_REPAIR_ENABLED=<keep-current-production-value>
AGENT_A_SINGLE_ROUTE=<keep-current-production-value>
AGENT_A_STATE_ASSERTIONS=<keep-current-production-value>
CONVERSATION_PIPELINE_V1_ENABLED=<keep-current-production-value>

# Material público servido por el Vercel de Lucas.
STUDYX_PUBLIC_ASSET_BASE_URL=https://studyx-agente-ventas-sigma.vercel.app

# Pago sandbox y verificación. Mantener los valores ya revisados; no usar live.
PAYMENT_PROVIDER=stripe_test
STRIPE_SECRET_KEY=<secret-test-key>
STRIPE_WEBHOOK_SECRET=<secret>
STRIPE_SUCCESS_URL=<current-production-value>
STRIPE_CANCEL_URL=<current-production-value>
PAYMENT_LINK_ENVIRONMENT=<keep-current-production-value>
PAYMENT_LINK_SANDBOX_12M=<secret-url>
PAYMENT_LINK_SANDBOX_6M=<secret-url>
PAYMENT_LINK_SANDBOX_CONTADO=<secret-url>
PAYMENT_LINK_STRIPE_VERIFICATION=<secret-url>
STRIPE_SANDBOX_WEBHOOK_SECRET=<secret>
STRIPE_VERIFICATION_SECRET=<secret>

# Bonificación y postventa. Mantener la configuración aprobada del entorno.
COURSE_BONUS_FLOW_MODE=<keep-current-production-value>
COURSE_BONUS_MAX_COURSES=<keep-current-production-value>
POST_SALE_ENABLED=<keep-current-production-value>
POST_SALE_CAMPUS_URL=https://mystudyx.com/campus-virtual
POST_SALE_OFFICIAL_WHATSAPP=786-916-4372
POST_SALE_STUDENT_SUPPORT_PHONE=866-217-7282
POST_SALE_ADMIN_EMAIL=info@mystudyx.com
POST_SALE_TEACHERS_EMAIL=studyxtutorias@gmail.com

# Central de Carga. No extender permisos temporales por medio de este archivo.
CENTRAL_CARGA_ENABLED=<keep-current-production-value>
CENTRAL_CARGA_BASE_URL=<current-production-value>
CENTRAL_CARGA_SIGNING_SECRET=<secret>
CENTRAL_CARGA_ENVIRONMENT=<keep-current-production-value>
CENTRAL_CARGA_ENROLL_PAID_AFTER=<current-production-value>
CENTRAL_CARGA_BONUS_ENABLED=<keep-current-production-value>
CENTRAL_CARGA_BONUS_CANARY_CONTACT_IDS=<current-production-value>
CENTRAL_CARGA_BONUS_CANARY_PHONE_E164S=<current-production-value>
CENTRAL_CARGA_BONUS_FULFILLMENT_PAUSED=<keep-current-production-value>
CENTRAL_CARGA_INITIAL_PASSWORD=<secret>
CENTRAL_CARGA_ALLOW_SANDBOX_CONTACTS=<keep-current-production-value>
CENTRAL_CARGA_SANDBOX_LIVE_UNTIL=<keep-current-production-value>

# Llamadas por Xendra.
VOICE_PROVIDER=xendra
XENDRA_CALL_URL=https://xendrapro-admin.vercel.app/api/studyx/llamar
XENDRA_ORCHESTRATOR_SECRET=<secret>
XENDRA_ADVISOR_NAME=Emma
XENDRA_CLOSER_NUMBER=<current-production-value>
XENDRA_REQUEST_TIMEOUT_MS=5000
RETELL_TOOLS_SECRET=<secret>

# Egreso administrado por el bot nuevo de admisiones.
BOTPRESS_MANAGED_EGRESS_TOKEN=<secret>
BOTPRESS_MANAGED_EGRESS_BOT_ID=e0f6be70-db0e-48e0-a9b7-f7864b6699d1
BOTPRESS_MANAGED_EGRESS_API_URL=https://api.botpress.cloud
MESSAGING_WHATSAPP_INTEGRATION_ID=whatsapp-cloud
MESSAGING_TELEGRAM_INTEGRATION_ID=telegram-bot
MESSAGING_CHANNEL_PREFERENCE=whatsapp,telegram

# WhatsApp directo sólo si el adaptador está habilitado en este entorno.
WHATSAPP_CLOUD_ACCESS_TOKEN=<secret>
WHATSAPP_CLOUD_PHONE_NUMBER_ID=<current-production-value>
WHATSAPP_CLOUD_GRAPH_API_VERSION=v26.0

# Lo fija el despliegue. Debe coincidir con /api/health después del deploy.
STUDYX_RELEASE_SHA=<deployed-git-sha>

# Claves que viven en Botpress, no en este archivo de Vercel:
# STUDYX_ORCHESTRATOR_KEY=<igual a Vercel ORCHESTRATOR_API_KEY>
# STUDYX_SIGNING_SECRET=<igual a Vercel STUDYX_SIGNING_SECRET>
# DEEPSEEK_API_KEY=<secret>
# GROQ_API_KEY=<secret para audio>
# GEMINI_API_KEY=<secret>
# CRON_SECRET=<secret>
