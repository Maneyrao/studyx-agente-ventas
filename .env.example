# Canonical PostgreSQL/Supabase connection for orchestrator_role.
DATABASE_URL=postgresql://orchestrator_role:replace-me@host:6543/postgres

# Independent secrets; generate high-entropy values and never commit real ones.
ORCHESTRATOR_API_KEY=replace-me
ORCHESTRATOR_KEY_ID=botpress-production
STUDYX_SIGNING_SECRET=replace-me
CRON_SECRET=replace-me

# Derived-memory provider. Canonical ingestion remains available if it is down.
OPENAI_API_KEY=replace-me

SUMMARY_THRESHOLD=10
SUMMARY_MODEL=gpt-4o-mini
RECENT_TURNS_LIMIT=10
LTM_RESULTS_LIMIT=5

# Botpress Emulator non-secret settings are configured with `adk config:set`, not env vars.
# See botpress-agent/README.md; use only a synthetic E.164 identity for local smoke tests.
