# ============================================================
# Runtime environment variables for the orchestrator
# Copy this file to .env.local and fill in real values
# ============================================================

# Postgres connection string for orchestrator_role (via Supavisor, transaction mode)
# Format: postgresql://orchestrator_role:<password>@<ref>.pooler.supabase.com:5432/postgres?pgbouncer=true
DATABASE_URL=postgresql://orchestrator_role:<password>@<ref>.pooler.supabase.com:5432/postgres?pgbouncer=true

# Postgres connection string for audit_writer (via Supavisor, transaction mode)
# Format: postgresql://audit_writer:<password>@<ref>.pooler.supabase.com:5432/postgres?pgbouncer=true
AUDIT_DATABASE_URL=postgresql://audit_writer:<password>@<ref>.pooler.supabase.com:5432/postgres?pgbouncer=true

# Google AI Studio (Gemini) API key: embeddings via gemini-embedding-2
# (768 dims, epoch gemini-embedding-2:768:retrieval-v1) and summaries via
# gemini-2.5-flash. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-me

# Internal API key for authenticating orchestrator-to-orchestrator calls
# Minimum 32 characters, randomly generated
ORCHESTRATOR_API_KEY=<random-string-min-32-chars>

# Secret for Vercel Cron authentication (auto-injected by Vercel in production)
# Set manually in .env.local for local development
CRON_SECRET=<random-string>

# Summary generation: number of turns before regenerating contact summary
SUMMARY_THRESHOLD=10

# Gemini model for contact summary generation
SUMMARY_MODEL=gemini-2.5-flash

# Number of recent turns to include in context
RECENT_TURNS_LIMIT=10

# Number of long-term-memory fragments returned by semantic search
LTM_RESULTS_LIMIT=5

# Retell Agent B (required only when VOICE_PROVIDER=retell). These are
# placeholders; keep real credentials and phone numbers in the secret store.
VOICE_PROVIDER=telegram_sandbox
RETELL_API_KEY=<retell-api-key>
RETELL_FROM_NUMBER=<retell-e164-number>
RETELL_API_BASE_URL=https://api.retellai.com
RETELL_AGENT_ID=agent_d2c1a4ac7900ae95a47727156b
RETELL_AGENT_VERSION=0
RETELL_LLM_ID=llm_eea8f670b6569b44689e9394b150
RETELL_LLM_VERSION=0
RETELL_ADVISOR_NAME=<advisor-display-name>
RETELL_TOOLS_SECRET=<random-tools-secret>
RETELL_REQUEST_TIMEOUT_MS=5000

# ============================================================
# Dev/CI only — NOT used by the orchestrator runtime
# These are only needed for the Supabase CLI and type generation
# ============================================================
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Tenant whose universal business data this deployment serves (workspaces.slug).
BUSINESS_WORKSPACE_SLUG=aburridont-english-it-sandbox
