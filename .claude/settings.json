{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(git status:*)",
      "Bash(git diff --stat:*)",
      "Bash(git log:*)",
      "Bash(npx adk check:*)",
      "Bash(npx adk status:*)",
      "Bash(npx adk logs:*)",
      "Bash(npx adk traces:*)",
      "Bash(npx adk integrations info:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(supabase db reset --linked:*)",
      "Bash(npx adk deploy:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./botpress-agent/.env)",
      "Read(./botpress-agent/agent.local.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/filter-bash-output.mjs" }
        ]
      }
    ]
  }
}
