# Canonical PostgreSQL/Supabase connection for orchestrator_role.
DATABASE_URL=

# Independent secrets; generate high-entropy values and never commit real ones.
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_KEY_ID=
STUDYX_SIGNING_SECRET=
CRON_SECRET=

# Derived-memory provider: embeddings (gemini-embedding-2, 768 dims) and
# summaries (gemini-2.5-flash). Canonical ingestion remains available if it is
# down; a missing/invalid key degrades vector recall, it does not stop writes.
#
# Three durable queues drain this key against knowledge_projection_jobs,
# selected_memories and message embeddings: `vercel.json`'s crons run them on
# whatever cadence the active Vercel plan allows (daily-only on Hobby). Until
# a paid plan allows a tighter schedule, drain them by hand with
# TEST_DATABASE_URL=<local-disposable-db> npx tsx scripts/run-knowledge-projection.ts
# TEST_DATABASE_URL=<local-disposable-db> npx tsx scripts/run-message-embeddings.ts
# TEST_DATABASE_URL=<local-disposable-db> npx tsx scripts/run-selected-memory-embeddings.ts
GEMINI_API_KEY=

# Production projection credentials. Keep the private key in the deployment
# secret store with its escaped newlines; never commit its value.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Payment provider selection (src/lib/config.ts loadPaymentProviderConfig).
# 'fake' (default, in-memory) | 'stripe_test' | 'stripe_live' (disabled outright
# in this phase — selecting it always throws before any Stripe call).
PAYMENT_PROVIDER=stripe_test

# Required only when PAYMENT_PROVIDER=stripe_test. Get these from the Stripe
# Dashboard (Developers -> API keys / Webhooks) for a TEST-mode account; a
# sk_live_/rk_live_ key is rejected outright by stripe_test.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint that receives
# src/app/api/webhooks/payments/stripe/route.ts (Developers -> Webhooks -> your endpoint).
STRIPE_WEBHOOK_SECRET=
# Where Stripe Checkout redirects after a completed/cancelled session.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

SUMMARY_THRESHOLD=10
SUMMARY_MODEL=gemini-2.5-flash
RECENT_TURNS_LIMIT=10
LTM_RESULTS_LIMIT=5

# Agent B Telegram voice sandbox. Keep disabled until the tester has sent
# /start to Bot B and the webhook has been configured explicitly.
VOICE_PROVIDER=telegram_sandbox
TELEGRAM_AGENT_B_BOT_TOKEN=replace-me
TELEGRAM_AGENT_B_WEBHOOK_SECRET=replace-me
TELEGRAM_AGENT_B_SMOKE_CHAT_ID=replace-me
TELEGRAM_AGENT_B_SMOKE_USER_ID=replace-me
TELEGRAM_AGENT_B_REQUEST_TIMEOUT_MS=5000
TELEGRAM_AGENT_B_SMOKE_ENABLED=false

# Botpress Emulator non-secret settings are configured with `adk config:set`, not env vars.
# See botpress-agent/README.md; use only a synthetic E.164 identity for local smoke tests.

# Tenant whose universal business data this deployment serves (workspaces.slug).
# Backend-derived: model output never selects the workspace.
BUSINESS_WORKSPACE_SLUG=studyx
# Optional locally; injected as the exact 40-character Git SHA on CLI deploys.
STUDYX_RELEASE_SHA=

# --- Outbound messaging channels (feature 007) ---
# The orchestrator delivers messages itself; these credentials never reach an agent.
# A channel with no token is simply absent: it is skipped during channel selection.
# Telegram reuses TELEGRAM_AGENT_B_BOT_TOKEN declared above.
MESSAGING_TELEGRAM_INTEGRATION_ID=telegram-bot
MESSAGING_WHATSAPP_INTEGRATION_ID=whatsapp-cloud
MESSAGING_REQUEST_TIMEOUT_MS=5000
# Deterministic fallback order when the caller states no preference.
MESSAGING_CHANNEL_PREFERENCE=whatsapp,telegram
# WhatsApp Cloud API. Pin the Graph API version: bumping it is a reviewed decision.
WHATSAPP_CLOUD_ACCESS_TOKEN=replace-me
WHATSAPP_CLOUD_PHONE_NUMBER_ID=replace-me
WHATSAPP_CLOUD_GRAPH_API_VERSION=v26.0
